# Loaded by `npm run build` on top of .env, and tracked: these are the values the Chrome Web Store
# build ships with. All are public by design. To build against a local dashboard instead, override
# them in .env.production.local, which is gitignored.
WXT_CONVEX_URL=https://festive-porpoise-146.convex.cloud
WXT_DASHBOARD_URL=https://app.tabcake.com
WXT_SITE_URL=https://tabcake.com
