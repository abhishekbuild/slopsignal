# Public by design: the Convex deployment URL is baked into every client.
WXT_CONVEX_URL=https://nautical-caribou-809.convex.cloud
# Where "Sign in with Tabcake" opens, and the only origin allowed to send a link code. wxt.config.ts
# reads it too, for externally_connectable. Production values are in .env.production.
WXT_DASHBOARD_URL=http://localhost:3000
# The marketing site, where the consent disclosure links the privacy policy.
WXT_SITE_URL=http://localhost:3001
